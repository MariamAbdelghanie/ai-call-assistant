LIVEKIT_URL=ws://127.0.0.1:7880
# Rastgele uretin; livekit.yaml icindeki keys bolumuyle ayni olmali.
# ornek: python -c "import secrets;print(secrets.token_urlsafe(32))"
LIVEKIT_API_KEY=generate_a_random_key
LIVEKIT_API_SECRET=generate_a_random_secret

# Panel ve mobil uygulamanin sunucuya erisim belirteci.
# Bos birakilirsa koruma kapanir (yalnizca yerel gelistirme icin).
API_TOKEN=generate_a_random_token

# Cascade (STT + LLM): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Realtime (Gemini Live): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

GOOGLE_CREDENTIALS_PATH=firebase-credentials.json
GOOGLE_CALENDAR_ID=your_email@gmail.com
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Bildirim konusu: tahmin edilemeyecek rastgele bir isim seçin
NTFY_TOPIC=your-random-private-topic

# ElevenLabs TTS (istege bagli; Arapca icin onerilir): https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_flash_v2_5
